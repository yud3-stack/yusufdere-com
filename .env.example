# Public Supabase project URL.
# Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Public key used by the browser and server reads.
# Dashboard → Project Settings → API Keys → Publishable key.
# The legacy anon JWT still works in this same variable if that is all the dashboard shows.
# Never put the secret or service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin allowlist. Never prefix this with NEXT_PUBLIC_.
# Must match the Supabase Auth user's email. Comparison is trimmed and case-insensitive.
ADMIN_EMAIL=

# Canonical site origin used for blog metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yusufdere.com

# Optional public analytics. Scripts load only after cookie consent (analytics=true).
# Leave NEXT_PUBLIC_ANALYTICS_PROVIDER empty to keep analytics disabled.
# Supported values: plausible | umami | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 admin reports. SERVER ONLY: never add NEXT_PUBLIC_ to these names.
# Property ID is numeric and is different from the G- measurement ID.
# Grant this service account Viewer access in GA4; enable the Analytics Data API.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Paste the PEM private key securely in the server/deployment environment.
# Escaped newline sequences (\n) are accepted. Never commit a real key.
GA4_PRIVATE_KEY=

# Instagram admin monitor. SERVER ONLY: never add NEXT_PUBLIC_ to these names.
# Reuse the long-lived token from ~/.config/instagram-monitor/.env (instagram-monitor plugin).
# Never commit a real token. Never paste it into chat or the admin UI.
INSTAGRAM_ACCESS_TOKEN=
# Optional. Defaults to the Instagram Graph host used by instagram-monitor.
INSTAGRAM_API_BASE=https://graph.instagram.com

# Weekly software Radar (admin homepage). SERVER ONLY.
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Never commit a real key. Never paste it into chat or the admin UI.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-lite-latest (free-tier friendly for new keys).
# Older names like gemini-2.0-flash / gemini-2.5-flash may be closed to new users.
GEMINI_MODEL=gemini-flash-lite-latest

# Daily quote discovery. SERVER ONLY. No paid quote/AI API is used.
# Same server key type as the content seed; never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Random bearer secret used by Vercel's /api/cron/quotes daily job.
CRON_SECRET=
# Defaults to automatic preparation + approval after source/translation checks.
# Set false to keep machine translations in the review queue.
QUOTE_AUTO_APPROVE=true
