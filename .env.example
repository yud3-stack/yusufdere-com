# Public Supabase project URL.
# Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Public key used by the browser and server reads.
# Dashboard → Project Settings → API Keys → Publishable key.
# The legacy anon JWT still works in this same variable if that is all the dashboard shows.
# Never put the secret or service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin allowlist. Never prefix this with NEXT_PUBLIC_.
# Must match the Supabase Auth user's email. Comparison is trimmed and case-insensitive.
ADMIN_EMAIL=

# Canonical site origin used for blog metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yusufdere.com

# Optional public analytics. Scripts load only after cookie consent (analytics=true).
# Leave NEXT_PUBLIC_ANALYTICS_PROVIDER empty to keep analytics disabled.
# Supported values: plausible | umami | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 admin reports. SERVER ONLY: never add NEXT_PUBLIC_ to these names.
# Property ID is numeric and is different from the G- measurement ID.
# Grant this service account Viewer access in GA4; enable the Analytics Data API.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Paste the PEM private key securely in the server/deployment environment.
# Escaped newline sequences (\n) are accepted. Never commit a real key.
GA4_PRIVATE_KEY=
